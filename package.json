{
    "name": "@jiovan-labs/typedoc-plugin-raw-content",
    "version": "2.0.0",
    "title": "Typedoc Plugin Raw Content",
    "description": "Generates extra raw html contents during typedoc compilation",
    "homepage": "https://jiovan-labs.github.io/typedoc-plugin-raw-content",
    "organization": "Jiovan Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "typedoc",
        "typedoc-plugin",
        "typedoc-plugin-raw-content"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/lib/index.js",
    "types": "dist/lib/index.d.ts",
    "type": "module",
    "sideEffects": false,
    "scripts": {
        "approve": "npm approve-scripts --allow-scripts-pending",
        "build": "del-cli ./dist && tsc --outDir ./dist/lib",
        "docs:build": "typedoc --out ./docs-dist",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "upgrade": "npx npm-check-updates --target semver -u"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^25.9.9",
        "del-cli": "^7.0.0",
        "eslint": "^10.14.0",
        "gh-pages": "^6.3.0",
        "globals": "^17.13.0",
        "typedoc": "~0.28.20",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.72.1"
    },
    "peerDependencies": {
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/jiovan-labs/typedoc-plugin-raw-content.git"
    },
    "bugs": {
        "url": "https://github.com/jiovan-labs/typedoc-plugin-raw-content/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/jiovan-labs"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/jiovan-labs"
        },
        {
            "type": "individual",
            "url": "https://jiovan.com/donation"
        }
    ],
    "author": {
        "name": "Jiovan Ltd",
        "url": "https://jiovan.com"
    },
    "contributors": [
        {
            "name": "David Hsing",
            "email": "davidhsing@163.com",
            "url": "https://github.com/davidhsing"
        }
    ]
}
