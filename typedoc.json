{
    "name": "Typedoc Plugin Raw Content",
    "entryPoints": [
        "src/index.tsx"
    ],
    "disableSources": true,
    "excludeExternals": true,
    "excludeInternal": true,
    "excludePrivate": true,
    "excludeProtected": true,
    "hideGenerator": true,
    "highlightLanguages": [
        "bash",
        "html",
        "js",
        "json",
        "jsx",
        "ts"
    ],
    "includeVersion": false,
    "navigationLinks": {
        "GitHub": "https://github.com/jiovan-labs/typedoc-plugin-raw-content",
        "Jiovan": "https://jiovan.com"
    },
    "plugin": [
        "./dist/lib/index.js"
    ],
    "rawHeadEnds": [
        "<meta name='keywords' content='typedoc, jiovan, typedoc-plugin-raw-content'/>"
    ],
    "rawFooterEnds": [
        "<div style='text-align: center'>Copyright &copy; 2026 Jiovan Ltd. All rights reserved</div>"
    ]
}
